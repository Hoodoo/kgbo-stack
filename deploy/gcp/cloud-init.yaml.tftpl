#cloud-config
# Container-Optimized OS processes this on every boot: it writes the files
# and starts the units. kgbo-disk mounts the data disk (formatting it only
# when it has no filesystem), kgbo-firewall opens the UI ports to the load
# balancer in COS's host firewall (its INPUT policy drops everything but
# SSH), and kgbo runs the stack's image with the disk as /kgbo. Shell logic
# lives in scripts, not Exec lines, because systemd rewrites $ and \ there.

write_files:
  - path: /etc/kgbo/mount-disk.sh
    permissions: "0644"
    content: |
      set -eu
      dev=/dev/disk/by-id/google-kgbo-data
      blkid "$dev" >/dev/null || mkfs.ext4 -m 0 -F "$dev"
      mkdir -p /mnt/disks/kgbo
      mountpoint -q /mnt/disks/kgbo || mount -o discard,defaults "$dev" /mnt/disks/kgbo
      chown 1000:1000 /mnt/disks/kgbo

  - path: /etc/kgbo/firewall.sh
    permissions: "0644"
    content: |
      set -eu
      # Only Google's load balancer and health-check ranges, as in the VPC
      # firewall: the UIs trust IAP's user header.
      for src in ${lb_ranges}; do
        rule="INPUT -p tcp -s $src -m multiport --dports ${ui_ports} -j ACCEPT"
        iptables -w -C $rule 2>/dev/null || iptables -w -I $rule
      done

  # Repositories the container clones and registers (kgbo-repos), copied
  # into the bundle's server/ directory on every start: Terraform owns them.
  - path: /etc/kgbo/repos.tsv
    permissions: "0644"
    content: |
      ${indent(6, repos_tsv)}

  - path: /etc/kgbo/workspaces.tsv
    permissions: "0644"
    content: |
      ${indent(6, workspaces_tsv)}

  # goatlassian's links to the sibling UIs, copied into its bundle directory
  # only when it has no config yet (an edited config is kept). Written here,
  # not by a unit, because systemd rewrites backslash escapes in Exec lines.
  - path: /etc/kgbo/goatlassian-config.toml
    permissions: "0644"
    content: |
      [services]
      owcli_url = "https://${owcli_host}"
      bossman_url = "https://${bossman_host}"

  - path: /etc/systemd/system/kgbo-disk.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Mount the kgbo data disk at /mnt/disks/kgbo
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/bash /etc/kgbo/mount-disk.sh

  - path: /etc/systemd/system/kgbo-firewall.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Open the kgbo UI ports to the load balancer
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/bash /etc/kgbo/firewall.sh

  - path: /etc/systemd/system/kgbo.service
    permissions: "0644"
    content: |
      [Unit]
      Description=kgbo stack services
      Requires=docker.service kgbo-disk.service kgbo-firewall.service
      After=docker.service kgbo-disk.service kgbo-firewall.service
      [Service]
      Environment=HOME=/home/kgbo-runner
      ExecStartPre=/bin/mkdir -p /home/kgbo-runner
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries=${registry_host}
      ExecStartPre=-/usr/bin/docker rm -f kgbo
      ExecStartPre=/bin/bash -c 'mkdir -p /mnt/disks/kgbo/goatlassian && cp -n /etc/kgbo/goatlassian-config.toml /mnt/disks/kgbo/goatlassian/config.toml; chown -R 1000:1000 /mnt/disks/kgbo/goatlassian'
      ExecStartPre=/bin/bash -c 'mkdir -p /mnt/disks/kgbo/server && cp /etc/kgbo/repos.tsv /etc/kgbo/workspaces.tsv /mnt/disks/kgbo/server/ && chown -R 1000:1000 /mnt/disks/kgbo/server'
      ExecStart=/usr/bin/docker run --rm --name kgbo --network host \
        -v /mnt/disks/kgbo:/kgbo \
        -e BOSSMAN_ADDR=0.0.0.0:7788 -e OWCLI_ADDR=0.0.0.0:4321 -e GOATLASSIAN_ADDR=0.0.0.0:7799 \
        -e BOSSMAN_HOST=${bossman_host} -e OWCLI_HOST=${owcli_host} -e GOATLASSIAN_HOST=${goatlassian_host} \
        -e KGBO_USER_HEADER=X-Goog-Authenticated-User-Email \
        ${image}
      ExecStop=/usr/bin/docker stop kgbo
      Restart=always
      RestartSec=10

runcmd:
  - systemctl daemon-reload
  - systemctl start kgbo-disk.service
  - systemctl start kgbo-firewall.service
  - systemctl start kgbo.service
