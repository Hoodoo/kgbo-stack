#!/bin/bash
# Runs the stack's services in one container and exits when any of them
# does, so the container's restart policy brings the set back together.
#   kgbo-services [run]   start kata's daemon and the three web UIs
#   kgbo-services check   exit 0 when every service answers
#
# Behind a reverse proxy (such as a load balancer with Google IAP):
#   BOSSMAN_ADDR, OWCLI_ADDR, GOATLASSIAN_ADDR   listen addresses (host:port)
#   BOSSMAN_HOST, OWCLI_HOST, GOATLASSIAN_HOST   public names to accept
#   KGBO_REPOS_EVERY   how often kgbo-repos syncs the clones listed in
#                      $KGBO_HOME/server/repos.tsv (default 15m; 0 disables)
#   KGBO_USER_HEADER   trusted header naming the signed-in user, e.g.
#                      X-Goog-Authenticated-User-Email; requests without it
#                      are refused, so only set it when nothing but the
#                      proxy can reach the container
set -euo pipefail
# The bundle's home variables (KATA_HOME and the rest) come from the image.

BOSSMAN_ADDR=${BOSSMAN_ADDR:-127.0.0.1:7788}
OWCLI_ADDR=${OWCLI_ADDR:-127.0.0.1:4321}
GOATLASSIAN_ADDR=${GOATLASSIAN_ADDR:-127.0.0.1:7799}
USER_HEADER=${KGBO_USER_HEADER:-}

# proxy_flags HOST prints the reverse-proxy flags for a UI whose public name
# is HOST (possibly empty), one per line.
proxy_flags() {
	if [[ -n $1 ]]; then printf '%s\n' --allow-host "$1"; fi
	if [[ -n $USER_HEADER ]]; then printf '%s\n' --user-header "$USER_HEADER"; fi
}

if [[ ${1:-run} == check ]]; then
	# The health check is local, so it vouches for itself when the UIs
	# require a user header.
	auth=()
	if [[ -n $USER_HEADER ]]; then auth=(-H "$USER_HEADER: kgbo-healthcheck"); fi
	# Probe each UI on loopback at its port: loopback names are always
	# accepted, whatever address the UI listens on.
	local_url() { echo "http://127.0.0.1:${1##*:}$2"; }
	kata health >/dev/null
	curl -fsS -o /dev/null "${auth[@]}" "$(local_url "$BOSSMAN_ADDR" /api/facets)"
	curl -fsS -o /dev/null "${auth[@]}" "$(local_url "$OWCLI_ADDR" /api/wikis)"
	curl -fsS -o /dev/null "${auth[@]}" "$(local_url "$GOATLASSIAN_ADDR" /api/meta)"
	exit 0
fi

mkdir -p "$KATA_HOME" "$OWCLI_HOME" "$BOSSMAN_HOME" "$GOATLASSIAN_HOME"

# KATA_LISTEN (host:port) also serves the daemon over TCP, for spokes.
kata daemon start --foreground ${KATA_LISTEN:+--listen "$KATA_LISTEN"} &
# Everything else may run kata (goatlassian, kgbo-repos), so it starts once
# the daemon answers. The image sets KATA_AUTOSTART=0: a kata command that
# found no daemon would otherwise start its own and make this one fail with
# "already listening".
for _ in $(seq 1 60); do kata health >/dev/null 2>&1 && break; sleep 1; done
kata health >/dev/null || { echo "kgbo-services: kata daemon did not come up" >&2; exit 1; }
# The server's bossman has no agent logs of its own: it shows what is
# shipped into the bundle, so it never syncs.
mapfile -t flags < <(proxy_flags "${BOSSMAN_HOST:-}")
bossman serve --addr "$BOSSMAN_ADDR" --no-sync "${flags[@]}" &
mapfile -t flags < <(proxy_flags "${OWCLI_HOST:-}")
owcli serve --no-open --addr "$OWCLI_ADDR" "${flags[@]}" &
mapfile -t flags < <(proxy_flags "${GOATLASSIAN_HOST:-}")
goatlassian serve --addr "$GOATLASSIAN_ADDR" "${flags[@]}" &

# Server-side clones: synced at start and then periodically. A failed sync
# is logged and retried; it never stops the services.
every=${KGBO_REPOS_EVERY:-15m}
if [[ -f $KGBO_HOME/server/repos.tsv && $every != 0 ]]; then
	(while true; do kgbo-repos || echo "kgbo-services: repository sync failed; retrying in $every" >&2; sleep "$every"; done) &
fi

trap 'kill $(jobs -p) 2>/dev/null; wait' TERM INT
status=0
wait -n || status=$?
echo "kgbo-services: a service exited ($status); stopping the rest" >&2
kill $(jobs -p) 2>/dev/null || true
wait || true
exit "$status"
